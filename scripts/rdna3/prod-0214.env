# A 对齐口径 env（基于 env-up-v0213.sh，仅改与 B 对齐项 + 多占内存项）
export STRATA_HIPBLASLT_TUNING=/home/yanyq/port/up0214/tools/hip/gfx1100-hipblaslt-100200.txt
export STRATA_HIP_WMMA=1
export STRATA_SELECT_WMMA=1
export STRATA_SH_STREAM=0
export STRATA_PREFILL_AUTO_MAX=32768
export STRATA_QFUSE=1
export STRATA_VERIFY_QDEDUP=1
export STRATA_PF_FUSED=1
export STRATA_STAGER_RING=64
# 与 B 对齐：0.6/4096 -> 0.3/1024
export STRATA_PREFILL_CPU_SHARE=0.6
export STRATA_PREFILL_CPU_SHARE_MAX=65536
export GPU_MAX_HW_QUEUES=6
export STRATA_GDN_HEAD=1
export STRATA_GDN_CHUNKED=1
export STRATA_GDN_PP=1
export STRATA_GDN_CONVL2=1
export STRATA_GDN_NOY=1
export STRATA_PF_GEMM=1
export STRATA_PF_PAD=1
export STRATA_HC_UPMIX=1
export STRATA_PF_HCDOWN=1
export STRATA_FUSE_CONVAB=1
export STRATA_HEAD_MIX_MULTI=1
export STRATA_PA_FAST=1
export STRATA_PF_F16=2
export STRATA_PREFILL_RING=192
export STRATA_KV_HOST_DMA=1
export STRATA_ADAPT_OVERLAP=1
export STRATA_QSA_ROWS=1
# A 二进制支持但原脚本漏开（与 B 对齐）
export STRATA_MMQ_DIRECT=1
export STRATA_HANDOFF_PIPE=4
# 多占系统内存：专家 arena 46.84 GiB 全量钉进 RAM（原走 file cache，未 pin）
export STRATA_ARENA_PIN_GIB=48
